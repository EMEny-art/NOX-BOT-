# --- CONFIG ---
COLOR = 0x0a0a0a # Nero professionale Nox
EMOJI_COIN = "💠"
DB = "database.json"

BRAINROTS = {
    "Tralalero Tralala": {"price": 500, "income": 10, "rarity": "Comune"},
    "Bombardiro Crocodilo": {"price": 2500, "income": 55, "rarity": "Raro"},
    "Tung Tung Sahur": {"price": 8000, "income": 200, "rarity": "Epico"},
    "Ballerina Cappuccina": {"price": 25000, "income": 700, "rarity": "Leggendario"},
    "Lirili Larila": {"price": 100000, "income": 3000, "rarity": "Mythic"},
}

def load_db():
    try:
        with open(DB, "r") as f: return json.load(f)
    except: return {}

def save_db():
    with open(DB, "w") as f: json.dump(db, f, indent=4)

db = load_db()

def get_user(uid):
    uid = str(uid)
    if uid not in db:
        db[uid] = {"coins": 750, "xp": 0, "level": 1, "daily": 0, "inventory": {}, "bank": 0}
    return db[uid]

# --- BOT ---
class NoxBot(commands.Bot):
    def __init__(self):
        intents = discord.Intents.all()
        super().__init__(command_prefix="!", intents=intents, help_command=None)
    async def setup_hook(self):
        await self.tree.sync()

bot = NoxBot()

def embed(title, desc):
    e = discord.Embed(title=title, description=desc, color=COLOR, timestamp=datetime.datetime.now())
    e.set_footer(text="NOX • Ultimate System")
    return e

# --- EVENTS ---
@bot.event
async def on_ready():
    print(f"NOX ULTIMATE CONNESSO: {bot.user}")
    await bot.change_presence(activity=discord.Activity(type=discord.ActivityType.watching, name="NOX Economy"))

@bot.event
async def on_message(message):
    if message.author.bot: return
    u = get_user(message.author.id)
    u["xp"] += random.randint(3, 8)
    if u["xp"] >= u["level"] * 350:
        u["level"] += 1
        await message.channel.send(embed=embed("LEVEL UP!", f"{message.author.mention} è salito al **Livello {u['level']}** 🚀"))
    save_db()
    await bot.process_commands(message)

# --- ECONOMY ---
@bot.hybrid_command(name="profilo", description="Vedi il tuo profilo Nox")
async def profilo(ctx):
    u = get_user(ctx.author.id)
    e = embed(f"Profilo di {ctx.author.name}", f"{EMOJI_COIN} **{u['coins']} NoxCoin**\n⭐ Livello **{u['level']}** ({u['xp']} XP)\n🎒 Brainrot: {len(u['inventory'])}")
    e.set_thumbnail(url=ctx.author.display_avatar.url)
    await ctx.send(embed=e)

@bot.hybrid_command(name="daily", description="Riscatta 500 NoxCoin giornalieri")
async def daily(ctx):
    u = get_user(ctx.author.id)
    now = datetime.datetime.now().timestamp()
    if now - u["daily"] < 86400:
        return await ctx.send(embed=embed("Già riscattato", "Torna tra 24h!"), ephemeral=True)
    u["coins"] += 500
    u["daily"] = now
    save_db()
    await ctx.send(embed=embed("Daily Riscattato", f"Hai ricevuto **500 {EMOJI_COIN}**! Totale: {u['coins']}"))

@bot.hybrid_command(name="shop", description="Shop Brainrot")
async def shop(ctx):
    desc = ""
    for name, data in BRAINROTS.items():
        desc += f"**{name}** [{data['rarity']}] - {data['price']} {EMOJI_COIN} → +{data['income']}/h\n"
    e = embed("🛒 NOX SHOP - Brainrot", desc)
    e.add_field(name="Come comprare", value="Usa `/buy nome` es: `/buy Tralalero Tralala`")
    await ctx.send(embed=e)

@bot.hybrid_command(name="buy", description="Compra un Brainrot")
async def buy(ctx, *, nome: str):
    u = get_user(ctx.author.id)
    item = BRAINROTS.get(nome.title())
    if not item: return await ctx.send(embed=embed("Errore", "Brainrot non trovato. Usa /shop"), ephemeral=True)
    if u["coins"] < item["price"]: return await ctx.send(embed=embed("Fondi insufficienti", f"Ti servono {item['price']}"), ephemeral=True)
    u["coins"] -= item["price"]
    u["inventory"][nome.title()] = u["inventory"].get(nome.title(), 0) + 1
    save_db()
    await ctx.send(embed=embed("Acquisto Effettuato", f"Hai comprato **{nome.title()}** per {item['price']} {EMOJI_COIN}!"))

@bot.hybrid_command(name="inventory", description="Vedi i tuoi Brainrot")
async def inventory(ctx):
    u = get_user(ctx.author.id)
    if not u["inventory"]: return await ctx.send(embed=embed("Inventario Vuoto", "Compra qualcosa con /shop"))
    txt = "\n".join([f"{k} x{v} (guadagno {BRAINROTS[k]['income']*v}/h)" for k,v in u["inventory"].items()])
    await ctx.send(embed=embed(f"🎒 Inventario di {ctx.author.name}", txt))

@bot.hybrid_command(name="steal", description="Ruba NoxCoin a un utente (20% di successo)")
async def steal(ctx, membro: discord.Member):
    if membro.id == ctx.author.id: return await ctx.send("Non puoi rubare a te stesso!")
    u = get_user(ctx.author.id)
    target = get_user(membro.id)
    if target["coins"] < 100: return await ctx.send(embed=embed("Troppo povero", "Quell'utente ha meno di 100 coin"))
    if random.random() < 0.2:
        rubato = random.randint(50, min(300, target["coins"]))
        target["coins"] -= rubato
        u["coins"] += rubato
        await ctx.send(embed=embed("💀 FURTO RIUSCITO", f"Hai rubato **{rubato} {EMOJI_COIN}** a {membro.mention}!"))
    else:
        multa = 100
        u["coins"] = max(0, u["coins"] - multa)
        await ctx.send(embed=embed("🚨 FURTO FALLITO", f"Sei stato beccato! Multa di {multa} {EMOJI_COIN}"))
    save_db()

# --- GIOCHI PROFESSIONALI ---
@bot.hybrid_command(name="coinflip", description="Testa o croce - 50/50")
async def coinflip(ctx, puntata: int, scelta: str):
    u = get_user(ctx.author.id)
    if u["coins"] < puntata: return await ctx.send(embed=embed("Errore", "NoxCoin insufficienti"), ephemeral=True)
    win = random.choice(["testa","croce"]) == scelta.lower()
    if win: u["coins"] += puntata
    else: u["coins"] -= puntata
    save_db()
    await ctx.send(embed=embed("Coinflip", f"{'VITTORIA' if win else 'SCONFITTA'}! Esito: {scelta} | Saldo: {u['coins']}"))

@bot.hybrid_command(name="leaderboard", description="Top NoxCoin e Livelli")
async def lb(ctx):
    top = sorted(db.items(), key=lambda x: x[1]['coins'], reverse=True)[:10]
    desc = "\n".join([f"**{i+1}.** <@{uid}> - {d['coins']} {EMOJI_COIN} - Lvl {d['level']}" for i, (uid,d) in enumerate(top)])
    await ctx.send(embed=embed("🏆 NOX LEADERBOARD", desc or "Nessuno"))

# --- TICKET ULTRA PROFESSIONALE ---
class TicketButtons(discord.ui.View):
    def __init__(self): super().__init__(timeout=None)
    @discord.ui.button(label="Apri Ticket", style=discord.ButtonStyle.blurple, emoji="🎫", custom_id="open_ticket")
    async def open(self, interaction, button):
        guild = interaction.guild
        cat = discord.utils.get(guild.categories, name="TICKETS")
        if not cat: cat = await guild.create_category("TICKETS")
        overwrites = {guild.default_role: discord.PermissionOverwrite(view_channel=False), interaction.user: discord.PermissionOverwrite(view_channel=True, send_messages=True), guild.me: discord.PermissionOverwrite(view_channel=True)}
        ch = await guild.create_text_channel(f"ticket-{interaction.user.name}", category=cat, overwrites=overwrites)
        await ch.send(f"{interaction.user.mention} Staff verrà da te! Descrivi il problema.", view=CloseButton())
        await interaction.response.send_message(f"Ticket aperto {ch.mention}", ephemeral=True)

class CloseButton(discord.ui.View):
    def __init__(self): super().__init__(timeout=None)
    @discord.ui.button(label="Chiudi Ticket", style=discord.ButtonStyle.red, emoji="🔒")
    async def close(self, interaction, button):
        await interaction.channel.delete(reason="Ticket chiuso")

@bot.hybrid_command(name="setup-ticket", description="Setup ticket professionale (Admin)")
@commands.has_permissions(administrator=True)
async def setup_ticket(ctx):
    e = embed("🎫 NOX SUPPORT", "Clicca qui sotto per aprire un ticket privato con lo staff.\n\n🛠️ Supporto • 💰 Pagamenti • 🚨 Segnalazioni")
    e.set_image(url="https://i.imgur.com/3Q8p6yH.png") # banner nero
    await ctx.send(embed=e, view=TicketButtons())

bot.run(os.environ["TOKEN"])
